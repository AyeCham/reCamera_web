        "name": "Count Ui",
        "order": 0,
        "width": "0",
        "height": "0",
        "head": "",
        "format": "<template>\n  <div class=\"root\">\n    <!-- CAMERA FEED -->\n    <div class=\"camera\">\n      <svg ref=\"svg\"></svg>\n    </div>\n\n    <!-- RESULT PANEL -->\n    <div class=\"result-panel\">\n      <h3>Conveyor Counter</h3>\n\n      <!-- COUNTS DISPLAY -->\n      <div class=\"count-display\">\n        <div class=\"total-count\">\n          <div class=\"count-box\">\n            <span class=\"label\">BAGS PASSED</span>\n            <span class=\"number\">{{ totalPassed }}</span>\n          </div>\n        </div>\n\n        <div v-if=\"lastPass\" class=\"last-event\">\n          Last Pass: <strong>{{ lastPass.label }}</strong>\n          <span style=\"font-size: 11px; color: #666;\">\n            {{ lastPass.time }}\n          </span>\n        </div>\n\n        <!-- BREAKDOWN BY CLASS -->\n        <div class=\"breakdown-full\">\n          <h4>Breakdown by Type</h4>\n          <div v-for=\"(count, cls) in passedCounts\" :key=\"cls\" class=\"detail-item\">\n            <span class=\"class-name\">{{ cls }}</span>: <strong>{{ count }}</strong>\n          </div>\n          <div v-if=\"Object.keys(passedCounts).length === 0\" class=\"empty\">No items passed yet</div>\n        </div>\n\n        <!-- ACTIVE TRACKING -->\n        <div class=\"tracking-status\">\n          <h4>Currently Tracked (IN zone)</h4>\n          <div v-for=\"(obj, key) in activeObjects\" :key=\"key\" class=\"tracked-item\">\n            {{ obj.label }}\n            <span style=\"color: #ff9800; font-size: 10px;\">⏳ in zone</span>\n          </div>\n          <div v-if=\"Object.keys(activeObjects).length === 0\" class=\"empty\">No active items</div>\n        </div>\n      </div>\n\n      <!-- LINE POSITION CONTROL -->\n      <div style=\"padding: 10px; background: white; margin-top: 10px; border: 1px solid #ddd; border-radius: 4px;\">\n        <strong style=\"font-size: 12px;\">Line Position: Y = {{ lineY }}</strong><br>\n        <button @click=\"adjustLine(-50)\" style=\"margin: 5px; padding: 5px 10px; font-size: 11px;\">⬆ UP</button>\n        <button @click=\"adjustLine(50)\" style=\"margin: 5px; padding: 5px 10px; font-size: 11px;\">⬇ DOWN</button>\n      </div>\n\n      <!-- DETECTION LOG -->\n      <div style=\"padding: 10px; background: #f0f0f0; margin-top: 10px; max-height: 150px; overflow-y: auto;\">\n        <h4 style=\"margin: 0 0 5px 0; font-size: 12px;\">Recent Events:</h4>\n        <div v-for=\"(log, i) in logs\" :key=\"i\" style=\"font-size: 11px; padding: 2px; font-family: monospace;\">\n          {{ log }}\n        </div>\n      </div>\n    </div>\n\n    <!-- CONTROLS -->\n    <div class=\"panel\">\n      <div class=\"buttons\">\n        <button class=\"start\" @click=\"sendCmd('start')\">▶ START</button>\n        <button class=\"stop\" @click=\"sendCmd('stop')\">⏹ STOP</button>\n        <button class=\"reset\" @click=\"resetCounts\">🔄 RESET</button>\n      </div>\n      <p class=\"status\">Camera: {{ wsStatus }}</p>\n    </div>\n  </div>\n</template>\n\n<script>\n  export default {\n  data() {\n    return {\n      ws: null,\n      wsStatus: \"Disconnected\",\n      isDrawing: false,\n\n      svgWidth: 640,\n      svgHeight: 640,\n      lineY: 300,\n\n      trackedObjects: {},\n      \n      // PASS-THROUGH TRACKING\n      activeObjects: {},\n      totalPassed: 0,\n      passedCounts: {},\n      lastPass: null,\n      \n      logs: [],\n      \n      // Performance optimization\n      lastImageUpdate: 0,\n      imageUpdateInterval: 33, // ~30fps max for image updates\n      lineElement: null,\n      labelElement: null,\n      imageElement: null,\n      processingFrame: false\n    };\n  },\n\n  methods: {\n    addLog(msg) {\n      const time = new Date().toLocaleTimeString();\n      this.logs.unshift(`[${time}] ${msg}`);\n      if (this.logs.length > 15) this.logs.pop();\n    },\n\n    resetCounts() {\n      this.totalPassed = 0;\n      this.passedCounts = {};\n      this.activeObjects = {};\n      this.trackedObjects = {};\n      this.lastPass = null;\n      this.logs = [];\n      this.addLog(\"🔄 Counter reset\");\n      \n      this.send({ topic: \"line_cross\", payload: { reset: true } });\n    },\n\n    sendCmd(cmd) {\n      this.send({ topic: \"ui_command\", payload: cmd });\n\n      if (cmd === \"start\") {\n        this.isDrawing = true;\n        this.addLog(\"▶ Started counting\");\n      }\n\n      if (cmd === \"stop\") {\n        this.isDrawing = false;\n        this.addLog(\"⏹ Stopped counting\");\n      }\n    },\n\n    adjustLine(delta) {\n      this.lineY += delta;\n      this.updateCountingLine();\n    },\n\n    initWS() {\n      this.ws = new WebSocket(`ws://${window.location.hostname}:8090`);\n      this.ws.binaryType = \"arraybuffer\";\n\n      this.ws.onopen = () => {\n        this.wsStatus = \"Connected\";\n        this.addLog(\"✅ WebSocket connected\");\n      };\n      \n      this.ws.onclose = () => {\n        this.wsStatus = \"Disconnected\";\n        this.addLog(\"❌ WebSocket disconnected\");\n      };\n\n      this.ws.onmessage = (e) => {\n        // Skip if already processing a frame\n        if (this.processingFrame) return;\n        \n        this.processingFrame = true;\n        \n        try {\n          const json = JSON.parse(\n            new TextDecoder().decode(new Uint8Array(e.data))\n          );\n          const data = json.data || json;\n\n          // Throttle image updates for better performance\n          const now = Date.now();\n          if (now - this.lastImageUpdate >= this.imageUpdateInterval) {\n            this.renderImage(data);\n            this.lastImageUpdate = now;\n          }\n\n          // Always process detection logic (this is fast)\n          if (this.isDrawing) {\n            this.checkLineCrossing(data);\n          }\n        } catch (err) {\n          console.error(\"WS parse error:\", err);\n        } finally {\n          this.processingFrame = false;\n        }\n      };\n    },\n\n    renderImage(data) {\n      if (!data?.image || !data?.resolution) return;\n\n      const svg = this.$refs.svg;\n      if (!svg) return;\n\n      // Cache resolution if changed\n      if (this.svgWidth !== data.resolution[0] || this.svgHeight !== data.resolution[1]) {\n        this.svgWidth = data.resolution[0];\n        this.svgHeight = data.resolution[1];\n        svg.setAttribute(\"viewBox\", `0 0 ${this.svgWidth} ${this.svgHeight}`);\n      }\n\n      // Reuse image element\n      if (!this.imageElement) {\n        this.imageElement = document.createElementNS(\"http://www.w3.org/2000/svg\", \"image\");\n        this.imageElement.setAttribute(\"x\", 0);\n        this.imageElement.setAttribute(\"y\", 0);\n        svg.appendChild(this.imageElement);\n      }\n\n      this.imageElement.setAttribute(\"width\", this.svgWidth);\n      this.imageElement.setAttribute(\"height\", this.svgHeight);\n      this.imageElement.setAttribute(\"href\", `data:image/jpeg;base64,${data.image}`);\n\n      // Draw line if not exists\n      if (!this.lineElement) {\n        this.drawCountingLine();\n      }\n    },\n\n    drawCountingLine() {\n      const svg = this.$refs.svg;\n      if (!svg) return;\n\n      // Create line element once\n      if (!this.lineElement) {\n        this.lineElement = document.createElementNS(\"http://www.w3.org/2000/svg\", \"line\");\n        this.lineElement.setAttribute(\"id\", \"counting-line\");\n        this.lineElement.setAttribute(\"stroke\", \"#ff3333\");\n        this.lineElement.setAttribute(\"stroke-width\", 4);\n        this.lineElement.setAttribute(\"stroke-dasharray\", \"10,5\");\n        svg.appendChild(this.lineElement);\n      }\n\n      // Create label element once\n      if (!this.labelElement) {\n        this.labelElement = document.createElementNS(\"http://www.w3.org/2000/svg\", \"text\");\n        this.labelElement.setAttribute(\"id\", \"line-label\");\n        this.labelElement.setAttribute(\"x\", 10);\n        this.labelElement.setAttribute(\"fill\", \"#ff3333\");\n        this.labelElement.setAttribute(\"font-size\", 18);\n        this.labelElement.setAttribute(\"font-weight\", \"bold\");\n        svg.appendChild(this.labelElement);\n      }\n\n      this.updateCountingLine();\n    },\n\n    updateCountingLine() {\n      if (!this.lineElement || !this.labelElement) return;\n\n      // Update line position\n      this.lineElement.setAttribute(\"x1\", 0);\n      this.lineElement.setAttribute(\"y1\", this.lineY);\n      this.lineElement.setAttribute(\"x2\", this.svgWidth);\n      this.lineElement.setAttribute(\"y2\", this.lineY);\n\n      // Update label\n      this.labelElement.setAttribute(\"y\", this.lineY - 10);\n      this.labelElement.textContent = ``;\n    },\n\n    checkLineCrossing(data) {\n      if (!Array.isArray(data?.boxes) || data.boxes.length === 0) return;\n\n      const PROXIMITY = 100;\n      const ZONE_THRESHOLD = this.lineY;\n      const now = Date.now();\n\n      // Process all boxes\n      data.boxes.forEach(([x, y, w, h, score, cls]) => {\n        const label = data.labels?.[cls] ?? `ID-${cls}`;\n        let matchedKey = null;\n\n        // Find existing tracked object (optimized loop)\n        for (const key in this.trackedObjects) {\n          const obj = this.trackedObjects[key];\n          if (obj.label === label) {\n            const dx = x - obj.x;\n            const dy = y - obj.y;\n            const distSq = dx * dx + dy * dy; // Skip sqrt for performance\n            if (distSq < PROXIMITY * PROXIMITY) {\n              matchedKey = key;\n              break;\n            }\n          }\n        }\n\n        const key = matchedKey || `${label}_${now}_${Math.random().toString(36).slice(2, 6)}`;\n\n        // Determine current zone\n        const currentZone = y < ZONE_THRESHOLD ? \"in\" : \"out\";\n\n        // SIMPLIFIED ZONE-BASED COUNTING\n        if (currentZone === \"in\") {\n          // Object entered IN zone (above line)\n          if (!this.activeObjects[key]) {\n            this.activeObjects[key] = { label, enteredAt: now };\n            this.addLog(`🟢 IN: ${label} (y=${y.toFixed(0)})`);\n            \n            this.send({\n              topic: \"line_cross\",\n              payload: { class: label, direction: \"in\" }\n            });\n          }\n        } else if (currentZone === \"out\") {\n          // Object moved to OUT zone (below line)\n          if (this.activeObjects[key]) {\n            // COUNT IT!\n            this.totalPassed++;\n            this.passedCounts[label] = (this.passedCounts[label] || 0) + 1;\n            \n            this.lastPass = {\n              label: label,\n              time: new Date().toLocaleTimeString()\n            };\n            \n            this.addLog(`✅ COUNTED: ${label} (Total: ${this.totalPassed})`);\n            \n            // Remove from active\n            delete this.activeObjects[key];\n            \n            this.send({\n              topic: \"line_cross\",\n              payload: { \n                class: label, \n                direction: \"out\",\n                counted: true,\n                total: this.totalPassed\n              }\n            });\n          }\n        }\n\n        // Update tracked position\n        this.trackedObjects[key] = { x, y, label, lastSeen: now };\n      });\n\n      // Cleanup stale objects (run less frequently)\n      if (now % 1000 < 50) { // Roughly once per second\n        for (const key in this.trackedObjects) {\n          if (now - this.trackedObjects[key].lastSeen > 5000) {\n            delete this.trackedObjects[key];\n            \n            if (this.activeObjects[key]) {\n              delete this.activeObjects[key];\n            }\n          }\n        }\n      }\n    },\n  },\n\n  mounted() {\n    this.initWS();\n  },\n\n  unmounted() {\n    if (this.ws) this.ws.close();\n  },\n};\n</script>\n\n<style>\n  .root {\n    display: grid;\n    grid-template-columns: 1fr 350px;\n    grid-template-rows: 1fr auto;\n    width: 100%;\n    height: 100%;\n    gap: 0;\n  }\n\n  .camera {\n    grid-column: 1;\n    grid-row: 1 / 3;\n    background: black;\n  }\n\n  .camera svg {\n    width: 100%;\n    height: 100%;\n  }\n\n  .result-panel {\n    grid-column: 2;\n    grid-row: 1;\n    padding: 15px;\n    background: #f9f9f9;\n    border-left: 2px solid #ddd;\n    overflow-y: auto;\n  }\n\n  .result-panel h3 {\n    margin: 0 0 15px 0;\n    color: #333;\n    font-size: 18px;\n  }\n\n  .count-display {\n    display: flex;\n    flex-direction: column;\n    gap: 15px;\n  }\n\n  .total-count {\n    display: flex;\n    justify-content: center;\n  }\n\n  .count-box {\n    padding: 20px;\n    border-radius: 8px;\n    text-align: center;\n    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n    border: 3px solid #5a67d8;\n    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n    width: 100%;\n  }\n\n  .count-box .label {\n    display: block;\n    font-size: 14px;\n    color: #fff;\n    font-weight: bold;\n    letter-spacing: 1px;\n  }\n\n  .count-box .number {\n    display: block;\n    font-size: 48px;\n    font-weight: bold;\n    margin-top: 5px;\n    color: #fff;\n  }\n\n  .last-event {\n    padding: 10px;\n    background: #d4edda;\n    border-radius: 4px;\n    font-size: 13px;\n    border: 1px solid #28a745;\n    text-align: center;\n  }\n\n  .breakdown-full {\n    padding: 12px;\n    background: white;\n    border-radius: 4px;\n    border: 1px solid #e0e0e0;\n  }\n\n  .breakdown-full h4 {\n    margin: 0 0 10px 0;\n    font-size: 14px;\n    color: #666;\n  }\n\n  .detail-item {\n    padding: 6px 0;\n    font-size: 13px;\n    border-bottom: 1px solid #f0f0f0;\n  }\n\n  .detail-item:last-child {\n    border-bottom: none;\n  }\n\n  .class-name {\n    color: #667eea;\n    font-weight: 600;\n  }\n\n  .tracking-status {\n    padding: 12px;\n    background: #fff3cd;\n    border-radius: 4px;\n    border: 1px solid #ffc107;\n  }\n\n  .tracking-status h4 {\n    margin: 0 0 8px 0;\n    font-size: 13px;\n    color: #856404;\n  }\n\n  .tracked-item {\n    padding: 4px 0;\n    font-size: 12px;\n    color: #856404;\n  }\n\n  .empty {\n    color: #999;\n    font-size: 11px;\n    font-style: italic;\n  }\n\n  .panel {\n    grid-column: 2;\n    grid-row: 2;\n    padding: 14px;\n    background: #f5f5f5;\n    border-left: 2px solid #ddd;\n    border-top: 2px solid #ddd;\n  }\n\n  .buttons {\n    display: flex;\n    gap: 8px;\n  }\n\n  button {\n    flex: 1;\n    padding: 10px;\n    font-weight: bold;\n    border: none;\n    cursor: pointer;\n    border-radius: 4px;\n    font-size: 12px;\n  }\n\n  .start {\n    background: #4caf50;\n    color: white;\n  }\n\n  .stop {\n    background: #f44336;\n    color: white;\n  }\n\n  .reset {\n    background: #ff9800;\n    color: white;\n  }\n\n  .status {\n    margin-top: 8px;\n    font-size: 12px;\n    color: #666;\n  }\n</style>",
