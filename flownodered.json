        "name": "Parse Upload Response",
        "func": "const statusCode = msg.statusCode;\nconst filename = msg.uploadInfo?.filename || 'unknown';\n\nif (statusCode === 200 || statusCode === 201) {\n    msg.uploadStatus = `✅ ${filename} uploaded`;\n} else if (statusCode === 409) {\n    msg.uploadStatus = `⚠️ ${filename} exists`;\n} else {\n    msg.uploadStatus = `❌ ${filename} failed (${statusCode}): ${msg.payload}`;\n}\n\nnode.warn(msg.uploadStatus);\nreturn msg;",
