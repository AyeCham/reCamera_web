    {
        "id": "b6a361aa5b2f3a6e",
        "type": "function",
        "z": "ccc7be52a837980a",
        "name": "Line Cross Counter",
        "func": "// Line Cross Counter - TRACKS IN, OUT, AND DOWNWARD_PASS\nif (msg.topic !== \"line_cross\") return [null, null];\n\n// Handle reset\nif (msg.payload.reset) {\n    flow.set(\"lineCrossCounts\", { in: {}, out: {}, counted: {} });\n    flow.set(\"lastTriggerTime\", {});\n    return [\n        { \n            payload: { \n                in: {}, \n                out: {}, \n                counted: {},\n                totalIn: 0, \n                totalOut: 0, \n                totalCounted: 0,\n                text: \"RESET\" \n            } \n        }, \n        null\n    ];\n}\n\nconst store = flow.get(\"lineCrossCounts\") || { in: {}, out: {}, counted: {} };\nconst cooldowns = flow.get(\"lastTriggerTime\") || {};\n\nconst { class: className, direction, counted, total } = msg.payload;\nif (!direction) return [null, null];\n\nconst now = Date.now();\n\n// Build log entry\nlet logMsg = null;\n\n// Handle different event types\nif (direction === \"downward_pass\") {\n    // DOWNWARD PASS = ACTUAL COUNT\n    const key = `${className}_counted`;\n    \n    // Debounce (500ms for counts to avoid double counting)\n    if (now - (cooldowns[key] || 0) < 500) return [null, null];\n    \n    cooldowns[key] = now;\n    store.counted[className] = (store.counted[className] || 0) + 1;\n    \n    // Log the actual count\n    logMsg = {\n        filename: `/home/recamera/logs/linecross_log_${new Date().toISOString().split(\"T\")[0]}.jsonl`,\n        payload: {\n            type: \"counted_pass\",\n            time: new Date().toISOString(),\n            item: className,\n            direction: \"downward_pass\",\n            total: total || store.counted[className]\n        }\n    };\n    \n} else if (direction === \"in\" || direction === \"out\") {\n    // IN/OUT ZONE TRACKING\n    const key = `${className}_${direction}`;\n    \n    // Debounce (300ms for zone events)\n    if (now - (cooldowns[key] || 0) < 300) return [null, null];\n    \n    cooldowns[key] = now;\n    store[direction][className] = (store[direction][className] || 0) + 1;\n    \n    // Log zone entry/exit\n    logMsg = {\n        filename: `/home/recamera/logs/linecross_log_${new Date().toISOString().split(\"T\")[0]}.jsonl`,\n        payload: {\n            type: `zone_${direction}`,\n            time: new Date().toISOString(),\n            item: className,\n            direction: direction\n        }\n    };\n}\n\nflow.set(\"lineCrossCounts\", store);\nflow.set(\"lastTriggerTime\", cooldowns);\n\n// Calculate totals\nconst totalIn = Object.values(store.in).reduce((a, b) => a + b, 0);\nconst totalOut = Object.values(store.out).reduce((a, b) => a + b, 0);\nconst totalCounted = Object.values(store.counted).reduce((a, b) => a + b, 0);\n\n// Build text for UI\nlet text = `IN: ${totalIn} | OUT: ${totalOut} | COUNTED: ${totalCounted}\\nLast: ${className} (${direction.toUpperCase()})`;\n\n// Send structured data for UI\nreturn [\n    { \n        payload: {\n            in: store.in,\n            out: store.out,\n            counted: store.counted,\n            totalIn,\n            totalOut,\n            totalCounted,\n            lastClass: className,\n            lastDirection: direction,\n            text\n        }\n    }, \n    logMsg\n];",
